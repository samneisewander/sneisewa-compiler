Grammar

    0 $accept: program $end

    1 program: stmt.list $end

    2 expr: expr.1 TOKEN_ASSIGNMENT expr
    3     | expr.1

    4 expr.1: expr.1 TOKEN_LOGICAL_OR expr.2
    5       | expr.2

    6 expr.2: expr.2 TOKEN_LOGICAL_AND expr.3
    7       | expr.3

    8 expr.3: expr.3 TOKEN_LESS_THAN expr.4
    9       | expr.3 TOKEN_LESS_THAN_OR_EQUAL expr.4
   10       | expr.3 TOKEN_GREATER_THAN expr.4
   11       | expr.3 TOKEN_GREATER_THAN_OR_EQUAL expr.4
   12       | expr.3 TOKEN_EQUAL expr.4
   13       | expr.3 TOKEN_NOT_EQUAL expr.4
   14       | expr.4

   15 expr.4: expr.4 TOKEN_ADD expr.5
   16       | expr.4 TOKEN_SUBTRACT expr.5
   17       | expr.5

   18 expr.5: expr.5 TOKEN_MULTIPLY expr.6
   19       | expr.5 TOKEN_DIVIDE expr.6
   20       | expr.5 TOKEN_REMAINDER expr.6
   21       | expr.6

   22 expr.6: expr.6 TOKEN_EXPONENT expr.7
   23       | expr.7

   24 expr.7: TOKEN_SUBTRACT expr.7
   25       | TOKEN_LOGICAL_NOT expr.7
   26       | expr.8

   27 expr.8: TOKEN_UNARY_ARRAY_LENGTH expr.8
   28       | expr.9

   29 expr.9: expr.10 TOKEN_POSTFIX_INCREMENT
   30       | expr.10 TOKEN_POSTFIX_DECREMENT
   31       | expr.10

   32 expr.10: TOKEN_LPAREN expr TOKEN_RPAREN
   33        | TOKEN_LBRACKET expr TOKEN_RBRACKET
   34        | TOKEN_IDENTIFIER expr.function
   35        | TOKEN_INTEGER_LITERAL
   36        | TOKEN_HEX_LITERAL
   37        | TOKEN_BINARY_LITERAL
   38        | TOKEN_DOUBLE
   39        | TOKEN_DOUBLE_SCIENTIFIC
   40        | TOKEN_KEY_TRUE
   41        | TOKEN_KEY_FALSE
   42        | TOKEN_CHARACTER_LITERAL
   43        | TOKEN_STRING_LITERAL

   44 expr.function: ε
   45              | TOKEN_LPAREN expr.list TOKEN_RPAREN

   46 expr.list: expr expr.list.item

   47 expr.list.item: ε
   48               | TOKEN_COMMA expr.list

   49 expr.list.opt: ε
   50              | expr.list

   51 expr.opt: ε
   52         | expr

   53 stmt: stmt.if.complex
   54     | stmt.if.simple
   55     | stmt.for.simple
   56     | stmt.for.complex

   57 stmt.if.complex: TOKEN_KEY_IF TOKEN_LPAREN expr TOKEN_RPAREN stmt.if.complex TOKEN_KEY_ELSE stmt.if.complex
   58                | TOKEN_KEY_IF TOKEN_LPAREN expr TOKEN_RPAREN stmt.for.complex TOKEN_KEY_ELSE stmt.if.complex
   59                | stmt.other

   60 stmt.if.simple: TOKEN_KEY_IF TOKEN_LPAREN expr TOKEN_RPAREN stmt
   61               | TOKEN_KEY_IF TOKEN_LPAREN expr TOKEN_RPAREN stmt.if.complex TOKEN_KEY_ELSE stmt.if.simple

   62 stmt.other: expr TOKEN_SEMICOLON
   63           | TOKEN_LCURLY stmt.list.opt TOKEN_RCURLY
   64           | TOKEN_KEY_PRINT expr.list.opt TOKEN_SEMICOLON
   65           | TOKEN_KEY_RETURN expr.opt TOKEN_SEMICOLON
   66           | decl

   67 stmt.for.complex: TOKEN_KEY_FOR TOKEN_LPAREN expr TOKEN_SEMICOLON expr TOKEN_SEMICOLON expr TOKEN_RPAREN stmt.if.complex

   68 stmt.for.simple: TOKEN_KEY_FOR TOKEN_LPAREN expr TOKEN_SEMICOLON expr TOKEN_SEMICOLON expr TOKEN_RPAREN stmt.if.simple

   69 stmt.list: stmt stmt.list.opt

   70 stmt.list.opt: ε
   71              | stmt.list

   72 decl: decl.array
   73     | decl.atomic

   74 decl.atomic: TOKEN_IDENTIFIER TOKEN_COLON decl.atomic.type decl.atomic.init TOKEN_SEMICOLON

   75 decl.array: TOKEN_IDENTIFIER TOKEN_COLON decl.array.type TOKEN_LBRACKET expr TOKEN_RBRACKET decl.atomic.type decl.array.init TOKEN_SEMICOLON

   76 decl.array.init: TOKEN_ASSIGNMENT TOKEN_LCURLY expr.list TOKEN_RCURLY

   77 decl.array.type: TOKEN_KEY_CARRAY
   78                | TOKEN_KEY_ARRAY
   79                | TOKEN_KEY_AUTO

   80 decl.atomic.type: TOKEN_KEY_AUTO
   81                 | TOKEN_KEY_BOOLEAN
   82                 | TOKEN_KEY_CHAR
   83                 | TOKEN_KEY_DOUBLE
   84                 | TOKEN_KEY_INTEGER
   85                 | TOKEN_KEY_STRING

   86 decl.atomic.init: ε
   87                 | TOKEN_ASSIGNMENT expr


