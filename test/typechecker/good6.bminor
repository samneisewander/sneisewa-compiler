// TEST: auto_function_return_inference.bminor
// EXPECTED: SUCCESS
get_value: function integer () = {
    return 42;
}

get_flag: function boolean () = {
    return true;
}

main: function integer () = {
    x: auto = get_value();  // Infers integer
    y: auto = get_flag();   // Infers boolean
    
    z: integer = x + 10;    // Valid
    w: boolean = y && false; // Valid
    return 0;
}