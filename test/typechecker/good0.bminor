// Arithmetic Expressions
a: integer = 1;
b: integer = 2;
x: double = 3.0;
y: double = 4.0;

main: function void () = {
    i: integer; 
    j: double;

    // Allowed operators for doubles
    j = x + y;
    j = x - y;
    j = x * y;
    j = x / y;
    
    j = x ^ y;
    j = x++;
    j = x--;
    j = x--;
}